---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../lib/content';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Daily Brief',
  description = 'A public, source-grounded newspaper of signals, papers, essays, podcasts, and field notes.'
} = Astro.props;
---
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('daily-brief-theme');
          const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = stored || preferred;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={withBase('/')}>THE DAILY BRIEF</a>
      <nav class="header-actions" aria-label="Site navigation">
        <a class="header-link" href={withBase('/archive/')}>Archive</a>
        <a class="header-link" href={withBase('/editorial-standards/')}>Standards</a>
        <ThemeToggle />
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <span>Source-led public editions · no tracking</span>
      <span><a href={withBase('/rss.xml')}>RSS</a> · <a href={withBase('/archive/')}>Past editions</a></span>
    </footer>
    <script is:inline>
      (() => {
        const button = document.querySelector('[data-theme-toggle]');
        if (!button) return;
        const setLabel = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          button.textContent = dark ? 'Day' : 'Night';
          button.setAttribute('aria-pressed', String(dark));
        };
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('daily-brief-theme', next); } catch (_) {}
          setLabel();
        });
        setLabel();
      })();
    </script>
  </body>
</html>
