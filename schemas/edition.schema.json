{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Brief edition",
  "type": "object",
  "required": ["date", "issue", "title", "subtitle", "items"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "issue": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "section", "kind", "title", "dek", "summary", "deskNote", "source", "sourceUrl", "published", "status", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "section": { "type": "string" },
        "kind": { "enum": ["article", "paper", "social", "repository", "podcast", "video", "special"] },
        "title": { "type": "string" },
        "dek": { "type": "string" },
        "summary": { "type": "string" },
        "deskNote": { "type": "string" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "published": { "type": "string", "format": "date" },
        "status": { "enum": ["checked", "reported", "contested", "moving", "thin"] },
        "links": { "type": "array", "minItems": 1 }
      }
    }
  }
}
